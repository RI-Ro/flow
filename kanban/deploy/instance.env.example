# =====================================================================
# Файл окружения одного экземпляра.
#
#   sudo install -d -m 750 /etc/kanban
#   sudo cp instance.env.example /etc/kanban/alpha.env
#   sudo chmod 600 /etc/kanban/alpha.env
#   sudo chown root:kanban /etc/kanban/alpha.env
#
# Права 600 обязательны: здесь пароль базы и ключ подписи токенов.
#
# Формат читает systemd, не оболочка: подстановки $VAR, кавычки и
# точки с запятой здесь НЕ работают. Значение пишется как есть, до
# конца строки.
# =====================================================================

# --- Сеть ---
# Порт у каждого экземпляра свой. Привязка к 127.0.0.1 означает, что
# снаружи экземпляр недоступен напрямую — только через обратный прокси.
# Если прокси не используется, укажите :8081, чтобы слушать все адреса.
APP_ADDR=127.0.0.1:8081

APP_ENV=production

# --- База ---
# У каждого экземпляра ОТДЕЛЬНАЯ база. Общая база означала бы, что
# пользователи и проекты видны всем экземплярам сразу.
DATABASE_URL=postgres://app_user:ПАРОЛЬ@localhost:5432/kanban_alpha?sslmode=disable

# Пул соединений. Суммарно по всем экземплярам не должен превышать
# max_connections в PostgreSQL (по умолчанию 100) с запасом на
# обслуживание: 3 экземпляра по 40 — уже перебор.
DB_POOL_SIZE=25
DB_MIN_IDLE=5

# --- Ключ подписи токенов ---
# Свой у каждого экземпляра. Общий ключ позволил бы предъявить токен,
# выданный одним сайтом, другому.
#   openssl rand -base64 48
JWT_SECRET=ЗАМЕНИТЬ

ACCESS_TTL=15m
REFRESH_TTL=720h

# --- Файлы ---
# Относительный путь разрешается от WorkingDirectory юнита,
# то есть /opt/kanban/alpha/uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25

# Интерфейс можно держать общим для всех экземпляров: статика
# одинаковая, разделять её незачем.
STATIC_DIR=/opt/kanban/web

# --- Прочее ---
RATE_LIMIT_PER_MIN=600

# Адреса обратных прокси, чьему заголовку X-Forwarded-For можно верить.
# ОБЯЗАТЕЛЬНО задать при работе за nginx или haproxy: иначе приложение
# видит адрес прокси вместо адреса клиента, и лимит частоты становится
# общим на всех пользователей сразу.
# Оставьте пустым при прямой работе без прокси — доверять заголовку от
# произвольного клиента нельзя, он его подделает.
TRUSTED_PROXIES=127.0.0.1,::1
ALLOW_SELF_REGISTRATION=false

# Нужен только если фронтенд отдаётся с другого адреса. При STATIC_DIR
# источник один и эта переменная не используется.
# ALLOWED_ORIGINS=https://alpha.example.com
