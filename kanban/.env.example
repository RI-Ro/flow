# Секрет для подписи access-токенов. Не короче 32 байт.
# Сгенерировать: openssl rand -base64 48
JWT_SECRET=

# Пароли ролей базы — должны совпадать с заданными в 0000_roles.sql,
# если вы их там меняли.
POSTGRES_PASSWORD=postgres
APP_DB_PASSWORD=change_me_user

ALLOWED_ORIGINS=http://localhost:5173

# --- Локальный запуск бэкенда без Docker ---
DATABASE_URL=postgres://app_user:change_me_user@localhost:5432/kanban?sslmode=disable
APP_ADDR=:8080
APP_ENV=development
UPLOAD_DIR=./var/uploads

# Каталог с собранным фронтендом. Если задан, тот же сервер отдаёт и
# интерфейс, и API — всё приложение доступно по одному адресу и порту,
# без отдельного веб-сервера и без настройки CORS.
# Собрать: cd frontend && npm run build  (результат в frontend/dist)
STATIC_DIR=
MAX_UPLOAD_MB=25
ACCESS_TTL=15m
REFRESH_TTL=720h
RATE_LIMIT_PER_MIN=600

# Самостоятельная регистрация. По умолчанию выключена: учётные записи
# заводит администратор через панель. Исключение — совершенно пустая
# база: там первая регистрация разрешена всегда и сразу даёт права
# администратора, иначе после установки войти было бы некому.
ALLOW_SELF_REGISTRATION=false

# --- Пул соединений с БД ---
# При 300 одновременных пользователях НЕ нужно 300 соединений: каждый
# REST-запрос занимает соединение на единицы миллисекунд (см. индексы
# в 0001_schema.sql), а не на всё время присутствия пользователя.
# 40 соединений с большим запасом покрывает такую нагрузку; поднимайте,
# если /healthz показывает dbConnsInUse близко к dbConnsMax подолгу.
DB_POOL_SIZE=40
DB_MIN_IDLE=8
